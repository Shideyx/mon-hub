{
  "manifest_version": 3,
  "name": "Mon Hub — Smily dans le navigateur",
  "short_name": "Mon Hub",
  "version": "1.0.0",
  "description": "Laisse Smily (Mon Hub, sur ton PC) lire et utiliser tes pages web quand tu le lui demandes. Rien ne part ailleurs que sur ton PC.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "debugger", "tabGroups", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Mon Hub : Smily dans le navigateur", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
